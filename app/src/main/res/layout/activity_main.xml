<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WiFi Kukuruyuk Gateway 📶"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Penangkap Notifikasi DANA Otomatis 24 Jam"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:padding="14dp"
            android:text="MEMERIKSA STATUS..."
            android:textColor="#EAB308"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIzinNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0284C7"
            android:text="1. Buka Izin Akses Notifikasi"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnIzinBaterai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#475569"
            android:text="2. Atur Baterai Tidak Dibatasi"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="URL Server Google Apps Script:"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#1E293B"
            android:padding="10dp"
            android:textColor="#F8FAFC"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSimpanUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#059669"
            android:text="Simpan URL"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#D97706"
            android:text="⚡ Tes Kirim Notifikasi DANA (Rp 10.000)"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Catatan Aktivitas Langsung (Live Log):"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:background="#020617"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textColor="#22C55E"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
